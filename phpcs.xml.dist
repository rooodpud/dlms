<?xml version="1.0"?>
<ruleset name="DeutschLMS">
	<description>WordPress Coding Standards for DeutschLMS.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tools/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<!-- Generated translation files (wp i18n make-php). -->
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- PSR-4 class files (src/Foo/BarBaz.php) instead of class-bar-baz.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="deutschlms"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dlms"/>
				<element value="DeutschLMS"/>
			</property>
		</properties>
	</rule>

	<!-- The repositories own custom tables, which are queried directly by design
	     (prepared statements; object-cached reads). -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/src/Enrollment/EnrollmentRepository.php</exclude-pattern>
		<exclude-pattern>/src/Progress/ProgressRepository.php</exclude-pattern>
		<exclude-pattern>/src/Quiz/AttemptRepository.php</exclude-pattern>
	</rule>

	<!-- Tests: PHPUnit naming and helpers. -->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Help language helpers (src/functions.php) return escaped HTML. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="dlms_t"/>
				<element value="dlms_attr"/>
				<element value="dlms_title"/>
				<element value="dlms_instruction"/>
			</property>
		</properties>
	</rule>
</ruleset>
