{
	"name": "deutschlms/deutschlms",
	"description": "DeutschLMS — a secure learning management system for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"dompdf/dompdf": "^3.1"
	},
	"autoload": {
		"psr-4": {
			"DeutschLMS\\": "src/"
		},
		"files": [
			"src/functions.php"
		]
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.1.0"
		}
	},
	"scripts": {
		"dev:install": "@php tools/composer.phar --working-dir=tools/dev install",
		"test": "@php tools/dev/vendor/bin/phpunit",
		"lint": "@php tools/dev/vendor/bin/phpcs",
		"lint:fix": "@php tools/dev/vendor/bin/phpcbf",
		"make-pot": "@php tools/dev/vendor/wp-cli/wp-cli/php/boot-fs.php i18n make-pot . languages/deutschlms.pot --slug=deutschlms --domain=deutschlms --exclude=node_modules,vendor,tools,tests",
		"make-translations": [
			"@php tools/dev/vendor/wp-cli/wp-cli/php/boot-fs.php i18n update-po languages/deutschlms.pot languages",
			"@php tools/dev/vendor/wp-cli/wp-cli/php/boot-fs.php i18n make-mo languages",
			"@php tools/dev/vendor/wp-cli/wp-cli/php/boot-fs.php i18n make-php languages"
		]
	}
}
