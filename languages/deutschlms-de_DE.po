#. Plugin Name of the plugin
#: deutschlms.php:3
#: src/Blocks/Blocks.php:61
msgid "DeutschLMS"
msgstr "DeutschLMS"

#. Description of the plugin
#: deutschlms.php:4
msgid "A secure learning management system: courses, lessons, topics, enrollment and progress tracking."
msgstr "Ein sicheres Lernmanagementsystem: Kurse, Lektionen, Themen, Einschreibung und Lernfortschritt."

#. Author of the plugin
#: deutschlms.php:8
msgid "Pradeep Hingorani"
msgstr "Pradeep Hingorani"

#. translators: 1: minimum PHP version, 2: minimum WordPress version.
#: deutschlms.php:38
#, php-format
msgid "DeutschLMS requires PHP %1$s and WordPress %2$s or newer. The plugin is inactive until the server is upgraded."
msgstr "DeutschLMS benötigt PHP %1$s und WordPress %2$s oder neuer. Das Plugin bleibt inaktiv, bis der Server aktualisiert ist."

#: deutschlms.php:58
msgid "DeutschLMS is missing its autoloader. Run \"composer install\" in the plugin folder."
msgstr "DeutschLMS fehlt der Autoloader. Führen Sie im Plugin-Ordner „composer install“ aus."

