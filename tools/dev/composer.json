{
	"name": "deutschlms/dev-tools",
	"description": "Development-only tooling for DeutschLMS (tests, coding standards, i18n). Never shipped with the plugin.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-cli/i18n-command": "^2.6",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "~7.1.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload-dev": {
		"psr-4": {
			"DeutschLMS\\": "../../src/",
			"DeutschLMS\\Tests\\": "../../tests/"
		}
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.1.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
