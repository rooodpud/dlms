{
	"name": "deutschlms",
	"version": "0.5.1",
	"private": true,
	"description": "Block sources for DeutschLMS. Compiled output in build/ ships with the plugin.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=blocks --output-path=build/blocks --webpack-copy-php",
		"start": "wp-scripts start --webpack-src-dir=blocks --output-path=build/blocks --webpack-copy-php",
		"lint:js": "wp-scripts lint-js blocks assets/js assets/admin",
		"lint:css": "wp-scripts lint-style \"assets/**/*.css\""
	},
	"devDependencies": {
		"@wordpress/scripts": "^36.0.0"
	}
}
