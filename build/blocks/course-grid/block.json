{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "deutschlms/course-grid",
  "version": "0.1.0",
  "title": "Course Grid",
  "category": "deutschlms",
  "icon": "grid-view",
  "description": "A grid of published courses, with progress for enrolled students.",
  "keywords": [
    "lms",
    "courses",
    "catalog"
  ],
  "textdomain": "deutschlms",
  "attributes": {
    "columns": {
      "type": "integer",
      "default": 3
    },
    "perPage": {
      "type": "integer",
      "default": 12
    },
    "orderBy": {
      "type": "string",
      "enum": [
        "date",
        "title",
        "menu_order"
      ],
      "default": "date"
    },
    "showProgress": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "dlms-frontend",
  "render": "file:./render.php"
}