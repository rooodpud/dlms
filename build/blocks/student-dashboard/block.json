{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "deutschlms/student-dashboard",
  "version": "0.1.0",
  "title": "Student Dashboard",
  "category": "deutschlms",
  "icon": "id-alt",
  "description": "The logged-in student's enrolled courses with percentage complete and a “Continue” link.",
